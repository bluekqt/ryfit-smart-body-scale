{
  "name": "ryfit-pcapp",
  "version": "2.0.0",
  "description": "RyFit 智能体质分析仪桌面应用",
  "author": "RyFit",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.ryfit.scaleapp",
    "productName": "RyFit智能体质分析仪",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "../static/ryfit-scale-icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "../static/ryfit-scale-icon.ico",
      "uninstallerIcon": "../static/ryfit-scale-icon.ico"
    },
    "extraResources": [
      {
        "from": "../dist/app.exe",
        "to": "backend/app.exe"
      },
      {
        "from": "../static/ryfit-scale-icon.ico",
        "to": "static/ryfit-scale-icon.ico"
      }
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  }
}